{
  "manifest_version": 3,
  "name": "간단 메모장",
  "version": "1.0.0",
  "description": "툴바에서 바로 여는 메모장. 여러 메모를 자동 저장·검색하고 .txt로 내보낼 수 있으며, 메모는 이 기기에만 보관됩니다.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "메모장 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
